{% set project = load_lua(path="config/project.lua") -%}
{% set personal = load_lua(path="config/personal.lua") -%}
(function() {
	'use strict';
	var app=angular.module('MyApp',['ngMaterial']);
	app.controller('AppCtrl', function($scope) {
		const gh = new GitHub();
		const me = gh.getUser('{{ personal.GITHUB_USERNAME }}');
		me.listRepos(function(err, repos) {
			$scope.projects=repos;
			/*
			for (var i=0;i<repos.length;i++) {
				console.log(repos[i].name);
				console.log(repos[i].homepage);
			};
			//console.log(repos);
			*/
		});
	});
})();
